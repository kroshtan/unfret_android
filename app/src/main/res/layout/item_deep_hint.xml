<?xml version="1.0" encoding="utf-8"?>
<!-- Under a quick result: what a deep check would add for this page, what it costs, and one button. Outlined, in the
     card's own colours: no colour of its own, no timer. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    app:cardBackgroundColor="@color/surface"
    app:cardElevation="0dp"
    app:strokeColor="@color/line"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/deep_hint_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Unfret.Body" />

        <TextView
            android:id="@+id/deep_hint_cost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance.Unfret.Small"
            android:textColor="@color/muted" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/deep_hint_action"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
