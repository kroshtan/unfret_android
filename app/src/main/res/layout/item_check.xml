<?xml version="1.0" encoding="utf-8"?>
<!-- One line of "What we checked": a round mark (checked, something to note, not checked), the area, why. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/check_mark"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@drawable/band_symbol"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:textColor="@color/on_band"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/check_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Unfret.Body" />

        <TextView
            android:id="@+id/check_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Unfret.Small"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
