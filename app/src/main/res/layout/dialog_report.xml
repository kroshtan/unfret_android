<?xml version="1.0" encoding="utf-8"?>
<!-- "Wrong result?": what the page really is, and what sending a report shares (the website's and extension's words). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="8dp">

    <RadioGroup
        android:id="@+id/report_reasons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RadioButton
            android:id="@+id/reason_real_brand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/report_real_brand" />

        <RadioButton
            android:id="@+id/reason_scam"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/report_scam" />

        <RadioButton
            android:id="@+id/reason_junk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/report_junk" />

        <RadioButton
            android:id="@+id/reason_other"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/report_other" />
    </RadioGroup>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/report_consent"
        android:textAppearance="@style/TextAppearance.Unfret.Small" />
</LinearLayout>
