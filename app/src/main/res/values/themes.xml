<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Unfret" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">@color/on_brand</item>
        <item name="colorPrimaryContainer">@color/brand_soft</item>
        <item name="colorOnPrimaryContainer">@color/brand_ink</item>
        <item name="colorSecondary">@color/brand_strong</item>
        <item name="colorOnSecondary">@color/on_brand</item>
        <item name="colorSecondaryContainer">@color/brand_soft</item>
        <item name="colorOnSecondaryContainer">@color/brand_ink</item>
        <item name="colorTertiary">@color/brand_strong</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorOnBackground">@color/ink</item>
        <item name="colorSurface">@color/bg</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/muted</item>
        <item name="colorSurfaceContainerLowest">@color/surface</item>
        <item name="colorSurfaceContainerLow">@color/surface</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface_2</item>
        <item name="colorSurfaceContainerHighest">@color/surface_2</item>
        <item name="colorOutline">@color/line_strong</item>
        <item name="colorOutlineVariant">@color/line</item>
        <item name="colorError">@color/stop</item>
        <item name="materialCardViewStyle">@style/Widget.Unfret.Card</item>
    </style>

    <style name="Widget.Unfret.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/line</item>
        <item name="cardCornerRadius">14dp</item>
        <item name="contentPadding">16dp</item>
    </style>

    <style name="TextAppearance.Unfret.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Unfret.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/ink_2</item>
    </style>

    <style name="TextAppearance.Unfret.Small" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/muted</item>
    </style>
</resources>
