<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 (API 31) and later: nothing goes into a Google backup or a device-to-device transfer (allowBackup off
  covers the backup; a transfer needs these rules). Not the intro's yes, not the WebView's data, nothing in files,
  databases, shared preferences or the cache. backup_rules.xml says the same for Android 11 and older; BackupRulesTest
  keeps the two in step.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
