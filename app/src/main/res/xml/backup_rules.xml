<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 (API 30) and older: nothing is backed up (allowBackup is off as well). data_extraction_rules.xml says the
  same for Android 12 and later.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
