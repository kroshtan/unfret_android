<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The only permission: the page is loaded, and unfret.net reached, over the phone's own connection. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Backups hold one yes/no only, that this phone already received its free checks (shared_prefs/free_checks.xml):
      res/xml/backup_rules.xml (Android 11 and older) and res/xml/data_extraction_rules.xml (12 and later). Never the
      pass.
    -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Unfret">

        <!-- The system WebView's usage statistics stay off. -->
        <meta-data
            android:name="android.webkit.WebView.MetricsOptOut"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          In the share sheet: a link, or text with a link in it, from a browser or any other app. It runs in its own
          process, the only one with a WebView, which ends (and whose WebView data is deleted) when the page is closed.
        -->
        <activity
            android:name=".CheckActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:process=":check"
            android:label="@string/share_label"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!--
          A pass handed over by a link: the "Use on your phone" QR code on unfret.net encodes
          https://unfret.net/pass#pass=ufk_… . Only that path (not /check, not the rest of the site); verified against
          unfret.net/.well-known/assetlinks.json. The activity only reads the link and hands the pass to the home
          screen, which asks before using it; it leaves no window and no entry in Recents.
        -->
        <activity
            android:name=".PassLinkActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="unfret.net" />
                <data android:path="/pass" />
            </intent-filter>
        </activity>
    </application>
</manifest>
